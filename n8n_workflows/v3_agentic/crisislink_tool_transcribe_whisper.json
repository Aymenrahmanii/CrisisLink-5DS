  {
   "parameters": {
    "jsCode": "// Telegram voice notes arrive as .oga, which Groq Whisper rejects -> rename to .ogg\nconst SUPPORTED = /\\.(flac|mp3|mp4|mpeg|mpga|m4a|ogg|wav|webm)$/i;\nfor (const item of $input.all()) {\n  const bin = item.binary && item.binary.data;\n  if (!bin) continue;\n  let name = (bin.fileName || 'voice.ogg').replace(/\\.oga$/i, '.ogg');\n  if (!SUPPORTED.test(name)) name += '.ogg';\n  bin.fileName = name;\n  bin.fileExtension = name.split('.').pop();\n  if (!bin.mimeType || bin.mimeType === 'application/octet-stream') bin.mimeType = 'audio/ogg';\n}\nreturn $input.all();"
   },
   "id": "3defd599-62cf-4e84-bc05-79afc85faa73",
